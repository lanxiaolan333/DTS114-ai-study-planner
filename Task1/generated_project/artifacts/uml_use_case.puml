@startuml
left to right direction
skinparam packageStyle rectangle

title AI Study Planner - Use Case Diagram

actor Student
actor Developer

rectangle "AI Study Planner" {
  usecase "Enter course and study preferences" as UC1
  usecase "Generate weekly study plan" as UC2
  usecase "View sample study plan" as UC3
  usecase "Check API health" as UC4
}

Student --> UC1
Student --> UC2
Student --> UC3
Developer --> UC4
UC2 ..> UC1 : <<include>>

@enduml
